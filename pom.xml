<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <name>jev-router-connector</name>
  <description>Camunda 8 outbound connector that routes work using the TypeSafe Jev model</description>
  <groupId>ai.typesafe.camunda</groupId>
  <artifactId>jev-router-connector</artifactId>
  <packaging>jar</packaging>
  <version>0.1.0-SNAPSHOT</version>

  <properties>
    <!--
      Java 21 is the floor the Camunda 8.9 connector SDK states, and compiling to it
      keeps the jar runnable on any 21+ Connector Runtime. Do not raise this without
      checking the runtime your connector is deployed into: a higher release makes the
      jar fail with UnsupportedClassVersionError on older runtimes.
    -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <version.connectors>8.9.12</version.connectors>
    <version.jackson>2.22.2</version.jackson>
    <version.slf4j>2.0.18</version.slf4j>
    <version.assertj>3.27.7</version.assertj>
    <version.junit-jupiter>6.1.2</version.junit-jupiter>
    <version.mockito>5.23.0</version.mockito>
    <!-- Overridden to empty by `./jev smoke` so the live tests can run. -->
    <test.excludedGroups>live</test.excludedGroups>
  </properties>

  <dependencies>
    <!--
      SDK artifacts are `provided`: the Connector Runtime supplies them at execution time.
      Bundling them would risk the classloading conflicts the upstream template warns about.
    -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-core</artifactId>
      <version>${version.connectors}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-validation</artifactId>
      <version>${version.connectors}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Element template generator annotations (compile-time only) -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>element-template-generator-annotations</artifactId>
      <version>${version.connectors}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      connector-core declares Jackson as `provided`, and provided scope is not transitive,
      so it must be declared here explicitly. Pinned to the exact version connector-core
      itself uses, to stay aligned with what the runtime puts on the classpath.
    -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${version.jackson}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${version.slf4j}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${version.junit-jupiter}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${version.assertj}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${version.mockito}</version>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${version.mockito}</version>
      <scope>test</scope>
    </dependency>

    <!-- OutboundConnectorContextBuilder, for building a test context with variables + secrets -->
    <dependency>
      <groupId>io.camunda.connector</groupId>
      <artifactId>connector-runtime-test</artifactId>
      <version>${version.connectors}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.6</version>
        <configuration>
          <!--
            Live tests hit the real API: they cost tokens and need a key, so a normal
            build never runs them. `./jev smoke` opts in with -Dgroups=live.
          -->
          <excludedGroups>${test.excludedGroups}</excludedGroups>
        </configuration>
      </plugin>

      <!--
        Declared explicitly (rather than relying on the default groupId resolution)
        so that `./jev ask` behaves the same on every machine.
      -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>

      <!--
        Version pinned explicitly: this project has no parent POM, so an unpinned shade
        plugin would resolve from Maven's default lifecycle binding and drift.
        No <relocations> are needed because nothing shaded is also supplied by the runtime.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!--
        Generates element-templates/jev-router-connector.json from the annotations on
        JevRouterFunction / JevRequest. Never hand-edit the generated JSON.
      -->
      <plugin>
        <groupId>io.camunda.connector</groupId>
        <artifactId>element-template-generator-maven-plugin</artifactId>
        <version>${version.connectors}</version>
        <executions>
          <execution>
            <!--
              Bound to process-classes rather than package so the template exists before
              tests run; ArtifactsTest then validates the freshly generated file on every build.
            -->
            <phase>process-classes</phase>
            <goals>
              <goal>generate-templates</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <connectors>
            <connector>
              <connectorClass>ai.typesafe.camunda.jev.JevRouterFunction</connectorClass>
              <files>
                <file>
                  <templateId>ai.typesafe.camunda.jev.router.v1</templateId>
                  <templateFileName>jev-router-connector.json</templateFileName>
                </file>
              </files>
            </connector>
          </connectors>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>connectors</id>
      <name>Connectors Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <pluginRepository>
      <id>connectors</id>
      <name>Connectors Repository</name>
      <url>https://artifacts.camunda.com/artifactory/connectors/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>
</project>
